<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 on Windows loads net7.0-windows (and net48 for the .NET Framework runtime). -->
    <TargetFrameworks>net7.0-windows;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ArchaiCompliance</RootNamespace>
    <AssemblyName>ArchaiCompliance</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Title>ARCHAI Compliance</Title>
    <Company>ARCHAI contributors</Company>
    <Description>Rhino 8 panel: scans the ARCHAI layer convention, exports metrics.json and runs "python -m archai check".</Description>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net7.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
